# CircleCI defaults for Cursor/Codex circleci skill.
# Install to the resolved runtime path:
#   Codex:  python3 ~/.codex/skills/scripts/agent_config.py --circleci-env
#   Cursor: python3 ~/.cursor/skills/scripts/agent_config.py --circleci-env
# Helpers read non-secret base URL from this file; prefer exporting CIRCLE_TOKEN in the shell.

CIRCLECI_API_BASE_URL=https://circleci.com/api/v2

# Optional when not exported as CIRCLE_TOKEN or CIRCLECI_TOKEN:
# CIRCLE_TOKEN=your-personal-api-token
