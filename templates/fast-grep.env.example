# fast-grep preferences (runtime-local; not committed to git)
# Resolve path: scripts/agent_config.py --fast-grep-env
# Cursor: ~/.cursor/fast-grep.env   Codex: ~/.codex/fast-grep.env
# Override home: AGENT_CONFIG_HOME=/path/to/config
#
# PREFERRED_SEARCH_TOOL — set when the user asks to change search tool (tool_id:
# ripgrep, ugrep, silver_searcher, git, ack, grep). Agent runs:
#   fast-grep-prefs.sh use <tool>
#
# DECLINED_INSTALL_OFFERS — comma-separated install-offer tool_ids skipped after
# the user declines installing a faster tool (ripgrep, ugrep, silver_searcher).
PREFERRED_SEARCH_TOOL=
DECLINED_INSTALL_OFFERS=
