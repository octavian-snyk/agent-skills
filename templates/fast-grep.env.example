# fast-grep preferences (runtime-local; not committed to git)
# Resolve path: scripts/agent_config.py --fast-grep-env
# Agent config home per runtime (e.g. ~/.cursor/ or ~/.codex/); override: AGENT_CONFIG_HOME
#
# Literal search: read this file on later runs (no rediscovery).
# First time: discover host chain → ask install or use <tool> → write here.
# Last literal resort when no host CLI: agent Grep tool (when runtime provides it).
#
# PREFERRED_SEARCH_TOOL — tool_id: ripgrep, ugrep, silver_searcher, git, ack, grep
#   fast-grep-prefs.sh use <tool>
#
# DECLINED_INSTALL_OFFERS — ripgrep,ugrep,silver_searcher after install declines
PREFERRED_SEARCH_TOOL=
DECLINED_INSTALL_OFFERS=
