# Atlassian Cloud defaults for Cursor/Codex jira & confluence skills.
# Install to the resolved runtime path:
#   python3 ~/.cursor/skills/scripts/agent_config.py --atlassian-env
# Helpers load non-secret URLs and ATLASSIAN_API_TOKEN from this file automatically.

ATLASSIAN_API_BASE_URL=https://example.atlassian.net
# Optional explicit Confluence REST v2 root:
# ATLASSIAN_CONFLUENCE_API_BASE_URL=https://example.atlassian.net/wiki/rest/api/v2

# Optional when not exported in the shell and not using ~/.config/.jira/.credentials:
# ATLASSIAN_API_TOKEN=your-api-token
