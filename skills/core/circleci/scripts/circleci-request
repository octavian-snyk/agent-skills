#!/bin/sh
set -eu
#
# CircleCI API v2 helper. Installed under ~/.cursor/skills/circleci or ~/.codex/skills/circleci
# after sync (see agent-skills AGENTS.md).

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  echo "usage: circleci-request [CIRCLECI_API_ROOT] METHOD PATH [JSON_BODY_FILE]" >&2
  exit 2
fi

agent_config_helper=""
_d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
while [ -n "$_d" ]; do
  if [ -r "$_d/scripts/agent-config.sh" ]; then
    agent_config_helper=$_d/scripts/agent-config.sh
    break
  fi
  [ "$_d" = "/" ] && break
  _d=$(dirname "$_d")
done
if [ -z "$agent_config_helper" ]; then
  echo "could not find scripts/agent-config.sh next to the agent-skills manifest helpers (install/sync repo copies)" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$agent_config_helper"
agent_config_init "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

normalize_api_root() {
  printf '%s\n' "${1%/}"
}

resolve_circleci_api_root() {
  if [ -n "${CIRCLECI_API_BASE_URL:-}" ]; then
    normalize_api_root "$CIRCLECI_API_BASE_URL"
    return 0
  fi
  if value=$(agent_config_read_var CIRCLECI_API_BASE_URL circleci.env); then
    normalize_api_root "$value"
    return 0
  fi
  printf '%s\n' "https://circleci.com/api/v2"
}

circleci_token_from_env_files() {
  if agent_config_read_var CIRCLE_TOKEN circleci.env; then
    return 0
  fi
  agent_config_read_var CIRCLECI_TOKEN circleci.env
}

require_circleci_token() {
  token=${CIRCLE_TOKEN:-}
  if [ -z "$token" ]; then
    token=${CIRCLECI_TOKEN:-}
  fi
  if [ -z "$token" ]; then
    if ! token=$(circleci_token_from_env_files); then
      echo "set CIRCLE_TOKEN or CIRCLECI_TOKEN, or define one in $(agent_config_defaults_hint circleci.env)" >&2
      exit 1
    fi
  fi
  CIRCLECI_HTTP_TOKEN=$token
  export CIRCLECI_HTTP_TOKEN
}

case "$1" in
  http://*|https://*)
    api_root=$(normalize_api_root "$1")
    method=$2
    path=$3
    body_file=${4:-}
    ;;
  *)
    api_root=$(resolve_circleci_api_root)
    method=$1
    path=$2
    body_file=${3:-}
    ;;
esac

case "$path" in
  /*)
    request_url=$api_root$path
    ;;
  *)
    request_url=$api_root/$path
    ;;
esac

require_circleci_token

if [ -n "$body_file" ]; then
  exec curl -sS \
    -X "$method" \
    -H "Circle-Token: $CIRCLECI_HTTP_TOKEN" \
    -H 'Accept: application/json' \
    -H 'Content-Type: application/json' \
    --data @"$body_file" \
    "$request_url"
fi

exec curl -sS \
  -X "$method" \
  -H "Circle-Token: $CIRCLECI_HTTP_TOKEN" \
  -H 'Accept: application/json' \
  "$request_url"
