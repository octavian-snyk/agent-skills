#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  echo "usage: jira-api [ISSUE_API_BASE] ISSUE_KEY [FIELDS]" >&2
  exit 2
fi

atlassian_auth_helper=""
_d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
while [ -n "$_d" ]; do
  if [ -r "$_d/scripts/atlassian-auth.sh" ]; then
    atlassian_auth_helper=$_d/scripts/atlassian-auth.sh
    break
  fi
  [ "$_d" = "/" ] && break
  _d=$(dirname "$_d")
done
if [ -z "$atlassian_auth_helper" ]; then
  echo "could not find scripts/atlassian-auth.sh next to the agent-skills manifest helpers (install/sync repo copies)" >&2
  exit 1
fi

# shellcheck source=/dev/null
. "$atlassian_auth_helper"

normalize_issue_api_base() {
  case "$1" in
    */rest/api/3/issue)
      printf '%s/\n' "$1"
      ;;
    */rest/api/3/issue/)
      printf '%s\n' "$1"
      ;;
    http://*|https://*)
      printf '%s/rest/api/3/issue/\n' "${1%/}"
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

read_default_base_from_env_file() {
  for env_file in "${HOME}/.cursor/atlassian.env" "${HOME}/.codex/atlassian.env"; do
    [ -r "$env_file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        ATLASSIAN_API_BASE_URL=*)
          printf '%s\n' "${line#ATLASSIAN_API_BASE_URL=}"
          return 0
          ;;
      esac
    done < "$env_file"
  done
  return 0
}

require_default_base() {
  default_source=${ATLASSIAN_API_BASE_URL:-}

  if [ -z "$default_source" ]; then
    default_source=$(read_default_base_from_env_file)
  fi

  if [ -z "$default_source" ]; then
    echo "ATLASSIAN_API_BASE_URL must be set when ISSUE_API_BASE is not provided" >&2
    exit 2
  fi

  normalize_issue_api_base "$default_source"
}

fields_default=summary,status,issuetype,priority,assignee,reporter,created,updated,description,comment,labels

case "$#" in
  1)
    issue_api_base=$(require_default_base)
    issue_key=$1
    fields=$fields_default
    ;;
  2)
    case "$1" in
      http://*|https://*)
        issue_api_base=$(normalize_issue_api_base "$1")
        issue_key=$2
        fields=$fields_default
        ;;
      *)
        issue_api_base=$(require_default_base)
        issue_key=$1
        fields=$2
        ;;
    esac
    ;;
  3)
    issue_api_base=$(normalize_issue_api_base "$1")
    issue_key=$2
    fields=$3
    ;;
esac

atlassian_require_auth

exec curl -sS \
  -u "$ATLASSIAN_AUTH_USERPASS" \
  -H 'Accept: application/json' \
  "${issue_api_base}${issue_key}?fields=$fields"
