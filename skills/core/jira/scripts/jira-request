#!/bin/sh
set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  echo "usage: jira-request [SITE_BASE] METHOD PATH [JSON_BODY_FILE]" >&2
  exit 2
fi

atlassian_auth_helper=""
_d=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
while [ -n "$_d" ]; do
  if [ -r "$_d/scripts/atlassian-auth.sh" ]; then
    atlassian_auth_helper=$_d/scripts/atlassian-auth.sh
    break
  fi
  [ "$_d" = "/" ] && break
  _d=$(dirname "$_d")
done
if [ -z "$atlassian_auth_helper" ]; then
  echo "could not find scripts/atlassian-auth.sh next to the agent-skills manifest helpers (install/sync repo copies)" >&2
  exit 1
fi

# shellcheck source=/dev/null
. "$atlassian_auth_helper"

normalize_site_base() {
  case "$1" in
    */rest/api/3/issue)
      printf '%s\n' "${1%/rest/api/3/issue}"
      ;;
    */rest/api/3/issue/)
      printf '%s\n' "${1%/rest/api/3/issue/}"
      ;;
    http://*|https://*)
      printf '%s\n' "${1%/}"
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

read_default_base_from_env_file() {
  for env_file in "${HOME}/.cursor/atlassian.env" "${HOME}/.codex/atlassian.env"; do
    [ -r "$env_file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        ATLASSIAN_API_BASE_URL=*)
          printf '%s\n' "${line#ATLASSIAN_API_BASE_URL=}"
          return 0
          ;;
      esac
    done < "$env_file"
  done
  return 0
}

require_site_base() {
  base_source=${ATLASSIAN_API_BASE_URL:-}

  if [ -z "$base_source" ]; then
    base_source=$(read_default_base_from_env_file)
  fi

  if [ -z "$base_source" ]; then
    echo "ATLASSIAN_API_BASE_URL must be set when SITE_BASE is not provided" >&2
    exit 2
  fi

  normalize_site_base "$base_source"
}

case "$1" in
  http://*|https://*)
    site_base=$(normalize_site_base "$1")
    method=$2
    path=$3
    body_file=${4:-}
    ;;
  *)
    site_base=$(require_site_base)
    method=$1
    path=$2
    body_file=${3:-}
    ;;
esac

case "$path" in
  /*)
    request_url=$site_base$path
    ;;
  *)
    request_url=$site_base/$path
    ;;
esac

atlassian_require_auth

if [ -n "$body_file" ]; then
  exec curl -sS \
    -X "$method" \
    -u "$ATLASSIAN_AUTH_USERPASS" \
    -H 'Accept: application/json' \
    -H 'Content-Type: application/json' \
    --data @"$body_file" \
    "$request_url"
fi

exec curl -sS \
  -X "$method" \
  -u "$ATLASSIAN_AUTH_USERPASS" \
  -H 'Accept: application/json' \
  "$request_url"
