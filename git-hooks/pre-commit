#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
validator="$repo_root/scripts/validate_skill.py"
manifest_reader="$repo_root/scripts/skill_manifest.py"

if [[ ! -x "$validator" ]]; then
  echo "missing executable validator: $validator" >&2
  exit 1
fi

if [[ ! -x "$manifest_reader" ]]; then
  echo "missing executable manifest reader: $manifest_reader" >&2
  exit 1
fi

changed_skill_paths=()
changed_files="$(git -C "$repo_root" diff --cached --name-only)"

while IFS=$'\t' read -r skill_name skill_path; do
  [[ -n "$skill_name" && -n "$skill_path" ]] || continue
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ "$path" == "$skill_path" || "$path" == "$skill_path/"* ]]; then
      changed_skill_paths+=("$repo_root/$skill_path")
      break
    fi
  done <<< "$changed_files"
done < <("$manifest_reader" list-skill-name-paths)

if [[ ${#changed_skill_paths[@]} -eq 0 ]]; then
  exit 0
fi

unique_paths=()
declare -A seen
for path in "${changed_skill_paths[@]}"; do
  if [[ -z "${seen[$path]:-}" ]]; then
    seen[$path]=1
    unique_paths+=("$path")
  fi
done

echo "Validating changed skills..."
python3 "$validator" "${unique_paths[@]}"
