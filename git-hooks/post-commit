#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"
dest_root="$HOME/.codex/skills"

mkdir -p "$dest_root" "$dest_root/scripts"

if [[ -f "$repo_root/ARTIFACTS.md" ]]; then
  cp "$repo_root/ARTIFACTS.md" "$dest_root/ARTIFACTS.md"
fi

if [[ -f "$repo_root/scripts/validate_artifact.py" ]]; then
  cp "$repo_root/scripts/validate_artifact.py" "$dest_root/scripts/validate_artifact.py"
  chmod +x "$dest_root/scripts/validate_artifact.py"
fi

for skill_dir in "$repo_root"/*; do
  if [[ -d "$skill_dir" && -f "$skill_dir/SKILL.md" ]]; then
    skill_name="$(basename "$skill_dir")"
    rm -rf "$dest_root/$skill_name"
    cp -R "$skill_dir" "$dest_root/$skill_name"
  fi
done
