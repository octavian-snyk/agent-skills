#!/usr/bin/env bash
set -euo pipefail

# Git runs hooks with the working tree as cwd; resolve repo root reliably when this path is a symlink.
repo_root="$(git rev-parse --show-toplevel)"

# Install skills for both Codex and Cursor on each commit (do not inherit a narrowed AGENT_SKILLS_SYNC_TARGETS from the user's shell).
exec env AGENT_SKILLS_SYNC_TARGETS=codex,cursor "$repo_root/scripts/sync_skills.sh" --all
